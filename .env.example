# ==============================================================================
# PATINHAS — VARIÁVEIS DE AMBIENTE
# ==============================================================================

# AMBIENTE
NODE_ENV=development
APP_PORT=3005
API_PORT=3333

# FRONTEND
VITE_API_URL=http://localhost:3333/api/v1
VITE_WS_URL=http://localhost:3333
VITE_APP_NAME="Patinhas"

# BACKEND
PORT=3333
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3005

# BANCO DE DADOS (PostgreSQL + PostGIS)
DB_HOST=postgres
DB_PORT=5433
DB_USER=patinhas_user
DB_PASSWORD=patinhas_secret_password
DB_NAME=patinhas_db
DATABASE_URL=postgresql://patinhas_user:patinhas_secret_password@postgres:5432/patinhas_db?schema=public

# REDIS (Cache & Filas BullMQ)
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# STORAGE S3 COMPATÍVEL (MinIO)
MINIO_ENDPOINT=minio
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=patinhas_admin
MINIO_ROOT_PASSWORD=patinhas_admin_secret
MINIO_BUCKET_NAME=patinhas-media
MINIO_USE_SSL=false
# URL pública do MinIO para acesso pelo navegador/frontend
MINIO_PUBLIC_URL=http://localhost:9010

# AUTENTICAÇÃO E CRIPTOGRAFIA
JWT_SECRET=super_secret_jwt_access_key_change_in_production_min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_parser_secret_key

# E-MAIL (Mailpit para Desenvolvimento / SMTP em Produção)
SMTP_HOST=mailpit
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Patinhas Adoção <contato@patinhas.org>"
MAILPIT_WEB_PORT=8026

# NOTIFICAÇÕES WEB PUSH (VAPID)
VAPID_PUBLIC_KEY=BExampleVapidPublicKeyForDevelopmentGenerateRealWithWebPushCLI
VAPID_PRIVATE_KEY=ExampleVapidPrivateKeyForDevelopmentGenerateRealWithWebPushCLI
VAPID_SUBJECT="mailto:suporte@patinhas.org"

# PROVEDORES EXTERNOS (Geocodificação e Mapas)
NOMINATIM_USER_AGENT="PatinhasAdocaoApp/1.0"
MAP_TILES_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"

