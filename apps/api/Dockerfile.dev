FROM node:20-alpine

WORKDIR /app

# Instala dependências de compilação nativa para alpine (argon2, openssl para prisma, etc.)
RUN apk add --no-cache python3 make g++ postgresql-client openssl

# Copia arquivos de configuração do monorepo
COPY package*.json ./
COPY packages/ ./packages/
COPY apps/api/package*.json ./apps/api/

# Instala dependências
RUN npm install

# Copia código-fonte da API
COPY apps/api/ ./apps/api/

WORKDIR /app/apps/api

EXPOSE 3333

CMD ["npm", "run", "start:dev"]

